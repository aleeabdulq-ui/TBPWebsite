    <script>
        (function() {
            'use strict';

            // ========== CONFIGURATION ==========
            const CONFIG = {
                splashDuration: 2500,
                scrollOffset: 100,
                searchDebounce: 300
            };

            // ========== TEAM DATA (FIXED - removed typo and consistent paths) ==========
            const teamMembers = [
                { name: "Michael Oluwafemi Alley", designation: "Principal Partner", hierarchy: 1, image: "../images/team/michael.jpg", profilePage: "../team/michael.html" },
                { name: "Oluwagbemisola Idowu", designation: "Associate Partner", hierarchy: 2, image: "../images/team/gbemi.jpg", profilePage: "../team/gbemi.html" },
                { name: "Olugboyega Tayo-Ojo", designation: "Associate Partner", hierarchy: 2, image: "../images/team/gboyega.jpg", profilePage: "../team/gboyega.html" },
                { name: "Nduka Akanu", designation: "Senior Associate", hierarchy: 3, image: "../images/team/nduka.jpg", profilePage: "../team/nduka.html" },
                { name: "Chyzoba Onwubiko", designation: "Senior Associate", hierarchy: 3, image: "../images/team/chyzoba.jpg", profilePage: "../team/chyzoba.html" },
                { name: "Ismail Opadokun", designation: "Senior Associate", hierarchy: 3, image: "../images/team/ismail.jpg", profilePage: "../team/ismail.html" },
                { name: "Quadri Bakare", designation: "Senior Associate", hierarchy: 3, image: "../images/team/quadri.jpg", profilePage: "../team/quadri.html" },
                { name: "Bode Ariyo", designation: "Senior Associate", hierarchy: 3, image: "../images/team/bode.jpg", profilePage: "../team/bode.html" },
                { name: "Kingsley Anyanwu", designation: "Senior Associate", hierarchy: 3, image: "../images/team/kingsley.jpg", profilePage: "../team/kingsley.html" },
                { name: "Onyedikachi Nwosu", designation: "Senior Associate", hierarchy: 3, image: "../images/team/onyedikachi.jpg", profilePage: "../team/onyedikachi.html" },
                { name: "Adegoke James", designation: "Construction Project Manager", hierarchy: 3, image: "../images/team/james.jpg", profilePage: "../team/james.html" },
                { name: "Adewale Aleem", designation: "Finance Manager", hierarchy: 3, image: "../images/team/wale.jpg", profilePage: "../team/wale.html" },
                { name: "John T. Alley", designation: "Business Development Consultant", hierarchy: 3, image: "../images/team/john.jpg", profilePage: "../team/john.html" },
                { name: "Nicole Duke", designation: "Mid-Level Associate", hierarchy: 4, image: "../images/team/nicole.jpg", profilePage: "../team/nicole.html" },
                { name: "Fawaz Adelaja", designation: "Mid-Level Associate", hierarchy: 4, image: "../images/team/fawaz.jpg", profilePage: "../team/fawaz.html" },
                { name: "Azeez Alakufo", designation: "Mid-Level Associate", hierarchy: 4, image: "../images/team/azeez.jpg", profilePage: "../team/azeez.html" },
                { name: "Ifeoluwa Nwajei", designation: "Mid-Level Associate", hierarchy: 4, image: "../images/team/ife.jpg", profilePage: "../team/ife.html" },
                { name: "Mayowa Osifowora", designation: "Mid-Level Associate", hierarchy: 4, image: "../images/team/mayowa.jpg", profilePage: "../team/mayowa.html" },
                { name: "Olumayowa Adegboye", designation: "Mid-Level Associate", hierarchy: 4, image: "../images/team/olumayowa.jpg", profilePage: "../team/olumayowa.html" },
                { name: "Ayelo Elukpo", designation: "Construction Site Manager", hierarchy: 4, image: "../images/team/ayelo.jpg", profilePage: "../team/ayelo.html" },
                { name: "Amadi Nnaemeka", designation: "Projects Coordinator", hierarchy: 4, image: "../images/team/amadi.jpg", profilePage: "../team/amadi.html" },
                { name: "Yewande Adeyemi", designation: "Human Resources Officer", hierarchy: 4, image: "../images/team/yewande.jpg", profilePage: "../team/yewamde.html" },
                { name: "Tahir Mohammed", designation: "Quantity Surveyor", hierarchy: 4, image: "../images/team/tahir.jpg", profilePage: "../team/tahir.html" },
                { name: "Olaosebikan Ajidagba", designation: "Arts Director", hierarchy: 4, image: "../images/team/olaosebikan.jpg", profilePage: "../team/olaosebikan.html" },
                { name: "Ali AbdulQuadir", designation: "IT Manager", hierarchy: 4, image: "../images/team/ali.jpg", profilePage: "../team/ali.html" },
                { name: "Adewunmi Adegoke", designation: "Site Engineer", hierarchy: 4, image: "../images/team/adewunmi.jpg", profilePage: "../team/adewunmi.html" },
                { name: "Oluwafemi Ayanniyi", designation: "Site Engineer", hierarchy: 4, image: "../images/team/oluwafemi.jpg", profilePage: "../team/oluwafemi.html" },
                { name: "Olushola Adeyemi", designation: "Junior Associate", hierarchy: 5, image: "../images/team/shola.jpg", profilePage: "../team/shola.html" },
                { name: "OreOluwa Orimogunje", designation: "Junior Associate", hierarchy: 5, image: "../images/team/ore.jpg", profilePage: "../team/ore.html" },
                { name: "Victor Oyebode", designation: "Junior Associate", hierarchy: 5, image: "../images/team/victor.jpg", profilePage: "../team/victor.html" },
                { name: "Ayanfeoluwa Vese", designation: "Junior Associate", hierarchy: 5, image: "../images/team/ayanfe.jpg", profilePage: "../team/ayanfe.html" },
                { name: "Joshua Adepoju", designation: "Junior Associate", hierarchy: 5, image: "../images/team/joshua.jpg", profilePage: "../team/joshua.html" },
                { name: "Uchechukwu Oleribe", designation: "Junior Associate", hierarchy: 5, image: "../images/team/uche.jpg", profilePage: "../team/uche.html" },
                { name: "Ogba Chigozie", designation: "Assistant Site Engineer", hierarchy: 5, image: "../images/team/ogba.jpg", profilePage: "../team/ogba.html" },
                { name: "Brenda Mekwunye", designation: "Social Media Manager", hierarchy: 5, image: "../images/team/brenda.jpg", profilePage: "../team/brenda.html" },
                { name: "Eweh Abang", designation: "Procurement Officer", hierarchy: 5, image: "../images/team/eweh.jpg", profilePage: "../team/eweh.html" },
                { name: "Chukwunonso Isichei", designation: "Graduate Architect", hierarchy: 6, image: "../images/team/chukwunonso.jpg", profilePage: "../team/chukwunonso.html" },
                { name: "Olabisi Jubril", designation: "Graduate Architect", hierarchy: 6, image: "../images/team/olabisi.jpg", profilePage: "../team/olabisi.html" },
                { name: "Esther Taiwo", designation: "Junior Accounts Officer", hierarchy: 6, image: "../images/team/esther.jpg", profilePage: "../team/esther.html" },
                { name: "Sarah Dennis", designation: "Administrative Officer", hierarchy: 6, image: "../images/team/sarah.jpg", profilePage: "../team/sarah.html" },
                { name: "Peter Ibiang", designation: "Office Assistant", hierarchy: 7, image: "../images/team/peter.jpg", profilePage: "../team/peter.html" }
            ].sort((a, b) => a.hierarchy - b.hierarchy);

            // ========== DOM HELPERS ==========
            const $ = (selector) => document.querySelector(selector);
            const $$ = (selector) => document.querySelectorAll(selector);

            // ========== ELEMENT REFERENCES ==========
            const elements = {
                splash: $('#splash'),
                splashSkip: $('#splashSkip'),
                header: $('#header'),
                navToggle: $('#navToggle'),
                navMenu: $('#navMenu'),
                themeToggle: $('#themeToggle'),
                themeIcon: $('#themeIcon'),
                backToTop: $('#backToTop'),
                searchInput: $('#searchInput'),
                teamGrid: $('#teamGrid'),
                resultCount: $('#resultCount'),
                noResults: $('#noResults'),
                clearSearchBtn: $('#clearSearchBtn'),
                gridViewBtn: $('#gridViewBtn'),
                listViewBtn: $('#listViewBtn'),
                currentYear: $('#currentYear')
            };

            // ========== UTILITIES ==========
            const utils = {
                debounce(fn, delay) {
                    let timer;
                    return function(...args) {
                        clearTimeout(timer);
                        timer = setTimeout(() => fn.apply(this, args), delay);
                    };
                },

                prefersReducedMotion() {
                    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                },

                prefersDarkMode() {
                    return window.matchMedia('(prefers-color-scheme: dark)').matches;
                },

                getInitials(name) {
                    const parts = name.split(' ');
                    if (parts.length >= 2) {
                        return (parts[0][0] + parts[1][0]).toUpperCase();
                    }
                    return parts[0].substring(0, 2).toUpperCase();
                },

                getBadge(hierarchy) {
                    switch(hierarchy) {
                        case 1: return { text: 'Principal', icon: 'bx-crown' };
                        case 2: return { text: 'Partner', icon: 'bx-star' };
                        case 3: return { text: 'Senior', icon: 'bx-badge-check' };
                        default: return null;
                    }
                },

                getRoleIcon(designation) {
                    const d = designation.toLowerCase();
                    if (d.includes('architect')) return 'bx-building-house';
                    if (d.includes('engineer')) return 'bx-hard-hat';
                    if (d.includes('manager')) return 'bx-briefcase-alt-2';
                    if (d.includes('partner')) return 'bx-crown';
                    if (d.includes('associate')) return 'bx-user-check';
                    if (d.includes('officer')) return 'bx-user';
                    if (d.includes('coordinator')) return 'bx-network-chart';
                    if (d.includes('consultant')) return 'bx-conversation';
                    if (d.includes('director')) return 'bx-palette';
                    if (d.includes('surveyor')) return 'bx-ruler';
                    if (d.includes('assistant')) return 'bx-support';
                    return 'bx-user';
                }
            };

            // ========== SPLASH SCREEN ==========
            const splash = {
                hide() {
                    if (!elements.splash) return;

                    if (utils.prefersReducedMotion()) {
                        elements.splash.style.display = 'none';
                        document.body.classList.remove('no-scroll');
                        animations.init();
                        return;
                    }

                    elements.splash.classList.add('hide');
                    document.body.classList.remove('no-scroll');

                    setTimeout(() => {
                        elements.splash.style.display = 'none';
                        animations.init();
                    }, 500);
                },

                init() {
                    if (!elements.splash) {
                        document.body.classList.remove('no-scroll');
                        return;
                    }

                    setTimeout(() => this.hide(), CONFIG.splashDuration);

                    elements.splashSkip?.addEventListener('click', () => this.hide());

                    document.addEventListener('keydown', (e) => {
                        if ((e.key === 'Enter' || e.key === 'Escape') && 
                            elements.splash && !elements.splash.classList.contains('hide')) {
                            this.hide();
                        }
                    });
                }
            };

            // ========== THEME MANAGEMENT ==========
            const theme = {
                current: localStorage.getItem('theme') || 'system',

                apply(themeName) {
                    this.current = themeName;
                    localStorage.setItem('theme', themeName);

                    const isDark = themeName === 'dark' || 
                                   (themeName === 'system' && utils.prefersDarkMode());

                    if (isDark) {
                        document.documentElement.setAttribute('data-theme', 'dark');
                        const iconEl = document.getElementById('themeIcon');
                        if (iconEl) iconEl.innerHTML = icons8.sun();
                    } else {
                        document.documentElement.removeAttribute('data-theme');
                        const iconEl = document.getElementById('themeIcon');
                        if (iconEl) iconEl.innerHTML = icons8.moon();
                    }
                },

                toggle() {
                    const newTheme = this.current === 'dark' ? 'light' : 'dark';
                    this.apply(newTheme);
                },

                init() {
                    this.apply(this.current);
                    elements.themeToggle?.addEventListener('click', () => this.toggle());
                    const themeIconEl = document.getElementById('themeIcon');
                    if (themeIconEl) {
                        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                        themeIconEl.innerHTML = isDark ? icons8.sun() : icons8.moon();
                    }

                    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
                        if (this.current === 'system') this.apply('system');
                    });
                }
            };

            // ========== NAVIGATION ==========
            const navigation = {
                isOpen: false,

                toggle() {
                    this.isOpen = !this.isOpen;
                    elements.navToggle?.classList.toggle('active', this.isOpen);
                    elements.navMenu?.classList.toggle('active', this.isOpen);
                    document.body.classList.toggle('no-scroll', this.isOpen);
                },

                close() {
                    this.isOpen = false;
                    elements.navToggle?.classList.remove('active');
                    elements.navMenu?.classList.remove('active');
                    document.body.classList.remove('no-scroll');
                },

                handleScroll() {
                    elements.header?.classList.toggle('scrolled', window.scrollY > 50);
                },

                init() {
                    elements.navToggle?.addEventListener('click', () => this.toggle());

                    $$('.nav-link').forEach(link => {
                        link.addEventListener('click', () => this.close());
                    });

                    window.addEventListener('scroll', () => this.handleScroll());

                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape' && this.isOpen) {
                            this.close();
                        }
                    });
                }
            };

            // ========== BACK TO TOP ==========
            const backToTop = {
                handleScroll() {
                    elements.backToTop?.classList.toggle('visible', window.scrollY > 500);
                },

                init() {
                    window.addEventListener('scroll', () => this.handleScroll());

                    elements.backToTop?.addEventListener('click', () => {
                        window.scrollTo({
                            top: 0,
                            behavior: utils.prefersReducedMotion() ? 'auto' : 'smooth'
                        });
                    });
                }
            };

            // ========== SCROLL ANIMATIONS ==========
            const animations = {
                observer: null,

                init() {
                    if (utils.prefersReducedMotion()) {
                        $$('.fade-in').forEach(el => el.classList.add('visible'));
                        return;
                    }

                    this.observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('visible');
                                this.observer.unobserve(entry.target);
                            }
                        });
                    }, { 
                        threshold: 0.1, 
                        rootMargin: '0px 0px -50px 0px' 
                    });

                    $$('.fade-in').forEach(el => this.observer.observe(el));
                }
            };

            // ========== TEAM CARDS ==========
            const teamCards = {
                createCard(member, index) {
                    const initials = utils.getInitials(member.name);
                    const badge = utils.getBadge(member.hierarchy);
                    const roleIcon = utils.getRoleIcon(member.designation);

    const card = document.createElement('div');
                    card.className = 'team-card';
                    card.style.transitionDelay = `${index * 50}ms`;
                    card.dataset.name = member.name.toLowerCase();
                    card.dataset.role = member.designation.toLowerCase();

                    const badgeHtml = badge ? 
                        `<div class="card-badge">
                            <i class='bx ${badge.icon}'></i>
                            <span>${badge.text}</span>
                        </div>` : '';

                    card.innerHTML = `
                        <div class="card-image-wrapper">
                            <img src="${member.image}" alt="${member.name}" loading="lazy" 
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="card-placeholder" style="display:none;">${initials}</div>
                            <div class="card-role-icon">
                                <i class='bx ${roleIcon}'></i>
                            </div>
                            ${badgeHtml}
                        </div>
                        <div class="card-body">
                            <div class="card-info">
                                <h3 class="card-name">${member.name}</h3>
                                <p class="card-role">${member.designation}</p>
                            </div>
<a href="${member.profilePage}" class="card-btn" target="_blank" rel="noopener">
                                <span>View Profile</span>
                                <i class='bx bx-right-arrow-alt'></i>
                            </a>
                        </div>
                    `;

                    return card;
                },

                render(searchQuery = '') {
                    const query = searchQuery.toLowerCase().trim();

                    let filtered = teamMembers;
                    if (query) {
                        filtered = teamMembers.filter(member =>
                            member.name.toLowerCase().includes(query) ||
                            member.designation.toLowerCase().includes(query)
                        );
                    }

                    elements.teamGrid.innerHTML = '';
                    elements.resultCount.textContent = filtered.length;

                    if (filtered.length === 0) {
                        elements.noResults.classList.add('visible');
                        return;
                    }

                    elements.noResults.classList.remove('visible');

                    // Show skeletons
                    for(let i = 0; i < Math.min(12, filtered.length); i++) {
                        const skeleton = document.createElement('div');
                        skeleton.className = 'team-card skeleton';
                        elements.teamGrid.appendChild(skeleton);
                    }

                    // Replace with real cards after delay
                    setTimeout(() => {
                        Array.from(elements.teamGrid.children).forEach(child => {
                            if(child.classList.contains('skeleton')) child.remove();
                        });

                        filtered.forEach((member, index) => {
                            const card = this.createCard(member, index);
                            elements.teamGrid.appendChild(card);
                        });

                        // Animate cards
                        requestAnimationFrame(() => {
                            $$('.team-card').forEach((card, i) => {
                                setTimeout(() => {
                                    card.classList.add('visible');
                                }, i * 50);
                            });
                        });
                    }, 800);
                },

                init() {
                    // Initial render
                    this.render();

                    // Search functionality
                    let searchTimeout;
                    elements.searchInput?.addEventListener('input', (e) => {
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(() => {
                            this.render(e.target.value);
                        }, CONFIG.searchDebounce);
                                    });

                    // Clear search
                    elements.clearSearchBtn?.addEventListener('click', () => {
                        elements.searchInput.value = '';
                        this.render();
                        elements.searchInput.focus();
                    });

                    // View toggle
                    elements.gridViewBtn?.addEventListener('click', () => {
                        elements.gridViewBtn.classList.add('active');
                        elements.listViewBtn.classList.remove('active');
                        elements.teamGrid.classList.remove('list-view');
                        localStorage.setItem('teamView', 'grid');
                    });

                    elements.listViewBtn?.addEventListener('click', () => {
                        elements.listViewBtn.classList.add('active');
                        elements.gridViewBtn.classList.remove('active');
                        elements.teamGrid.classList.add('list-view');
                        localStorage.setItem('teamView', 'list');
                    });

                    // Restore saved view preference
                    const savedView = localStorage.getItem('teamView');
                    if (savedView === 'list') {
                        elements.listViewBtn?.click();
                    }
                }
            };

            // ========== DYNAMIC YEAR ==========
            const setCurrentYear = () => {
                if (elements.currentYear) {
                    elements.currentYear.textContent = new Date().getFullYear();
                }
            };

            // ========== INITIALIZATION ==========
            const init = () => {
                splash.init();
                theme.init();
                navigation.init();
                backToTop.init();
                teamCards.init();
                setCurrentYear();
            };

            // Run on DOM ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }

        })();
    </script>
</body>
</html>


