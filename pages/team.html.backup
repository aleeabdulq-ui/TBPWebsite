<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Architecture Team Nigeria | Lagos Architects ARCON Registered | TBP Team</title>
    <meta name="description" content="ARCON-registered architects Nigeria team - Principal partners Lagos, senior architects Abuja, construction managers Port Harcourt. Meet TBP's award-winning Nigerian architecture professionals.">
    <meta name="keywords" content="architects Nigeria, architecture team Lagos, ARCON architects Nigeria, Nigerian architects, Lagos architects team, building design team Nigeria, TBP architects">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://thebuildingpractice.com/pages/team.html">
    <!-- NEOMORPHIC 3D SYSTEM - Team Page -->
    <link rel="stylesheet" href="../css/neomorphic.css">
    <link rel="stylesheet" href="../css/global.css">
    
    <!-- Open Graph -->
    <meta property="og:title" content="Architecture Team Nigeria | ARCON Registered Architects | TBP">
    <meta property="og:description" content="Meet our expert Nigerian architects team - Principal partners, senior architects serving Lagos, Abuja, Port Harcourt.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thebuildingpractice.com/pages/team.html">
    <meta property="og:image" content="https://thebuildingpractice.com/images/og/team-nigeria.jpg">
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Architecture Team Nigeria | TBP Architects">
    <meta name="twitter:description" content="ARCON-registered architects Lagos Nigeria - Principal partners, senior architects team.">
    <meta name="twitter:image" content="https://thebuildingpractice.com/images/og/team-nigeria.jpg">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="vendor/boxicons.min.css" rel="stylesheet">
    
    <style>
        /* ========================================
           TEAM PAGE - 3D NEOMORPHIC ENHANCEMENTS 
           All cards/tags get 3D shadows from neomorphic.css
        ======================================== */
        /* Team cards now use --shadow-3d-md → --shadow-3d-xl on hover */
        
        .team-card,
        .card-image-wrapper,
        .card-role-icon,
        .card-badge,
        .controls-section,
        .search-wrapper,
        .view-toggle,
        .result-count {
            box-shadow: var(--shadow-3d-md);
        }

        .team-card:hover,
        .card-image-wrapper:hover,
        .search-input:focus,
        .view-btn.active,
        .card-role-icon:hover,
        .card-badge:hover {
            box-shadow: var(--shadow-3d-lg);
            transform: translateY(-4px);
        }

        /* Search input + controls get 3D inset effect */
        .search-input {
            box-shadow: var(--shadow-3d-xs);
        }

        .search-input:focus {
            box-shadow: var(--shadow-3d-sm), 0 0 0 4px rgba(var(--primary), 0.1);
        }

        /* Tags get XS shadows */
        .tag,
        .card-badge {
            box-shadow: var(--shadow-3d-xs);
        }

        .tag:hover {
            box-shadow: var(--shadow-3d-sm);
            transform: translateY(-2px);
        }

        /* Responsive 3D scaling */
        @media (max-width: 768px) {
            .team-card {
                box-shadow: var(--shadow-3d-sm);
            }
            .team-card:hover {
                box-shadow: var(--shadow-3d-md);
            }
        }

        /* Mobile cards scale down shadows */
        @media (max-width: 640px) {
            .shadow-3d-md { 
                box-shadow: var(--shadow-3d-sm) !important; 
            }
        }

        /* Universal lift on hover */
        .neu-3d-hover:hover {
            transform: translateY(-4px) !important;
            box-shadow: var(--shadow-3d-lg) !important;
        }

        /* Dark Mode */
        [data-theme="dark"] {
            --bg-primary: var(--gray-900);
            --bg-secondary: var(--gray-800);
            --bg-tertiary: var(--gray-700);
            --text-primary: var(--white);
            --text-secondary: var(--gray-300);
            --text-tertiary: var(--gray-500);
            --border-primary: var(--gray-700);
            --border-secondary: var(--gray-600);
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.6);
            --shadow-glow: 0 0 40px rgba(0, 172, 193, 0.2);
        }

        /* ========================================
           BASE RESET
        ======================================== */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: var(--font-family);
            font-size: var(--text-base);
            line-height: 1.6;
            color: var(--text-primary);
            background-color: var(--bg-primary);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
        }

        body.no-scroll {
            overflow: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        button {
            font-family: inherit;
            cursor: pointer;
            border: none;
            background: none;
        }

        ul, ol {
            list-style: none;
        }

        /* ========================================
           SPLASH SCREEN - COOL GRADIENT THEME
        ======================================== */
        .splash {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

        .splash::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 30%, rgba(0, 172, 193, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 70% 70%, rgba(156, 39, 176, 0.1) 0%, transparent 50%);
            animation: splashBgPulse 4s ease-in-out infinite;
        }

        @keyframes splashBgPulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 1; }
        }

        .splash.hide {
            opacity: 0;
            visibility: hidden;
        }

        .splash-logo-wrapper {
            position: relative;
            width: 160px;
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

        .splash-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            animation: splashRingSpin 2s linear infinite;
        }

        @keyframes splashRingSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .splash-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            animation: splashLogoFade 1s ease forwards;
            filter: drop-shadow(0 4px 20px rgba(0, 172, 193, 0.3));
        }

        @keyframes splashLogoFade {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }

        .splash-title {
            margin-top: var(--space-5);
            font-size: var(--text-xl);
            font-weight: 600;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid), var(--gradient-end));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            opacity: 0;
            animation: splashTextIn 0.6s ease 0.3s forwards;
            z-index: 1;
        }

        .splash-tagline {
            margin-top: var(--space-2);
            font-size: var(--text-sm);
            color: var(--text-tertiary);
            font-style: italic;
            opacity: 0;
            animation: splashTextIn 0.6s ease 0.5s forwards;
            z-index: 1;
        }

        @keyframes splashTextIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .splash-loader {
            margin-top: var(--space-8);
            display: flex;
            gap: var(--space-3);
            opacity: 0;
            animation: splashTextIn 0.6s ease 0.7s forwards;
            z-index: 1;
        }

        .splash-loader span {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            animation: splashDot 1.4s ease-in-out infinite;
        }

        .splash-loader span:nth-child(1) {
            background: var(--gradient-start);
            animation-delay: 0s;
        }

        .splash-loader span:nth-child(2) {
            background: var(--gradient-mid);
            animation-delay: 0.2s;
        }

        .splash-loader span:nth-child(3) {
            background: var(--gradient-end);
            animation-delay: 0.4s;
        }

        @keyframes splashDot {
            0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
            40% { transform: scale(1.2); opacity: 1; }
        }

        .splash-skip {
            position: absolute;
            bottom: var(--space-12);
            font-size: var(--text-sm);
            color: var(--text-tertiary);
            cursor: pointer;
            opacity: 0;
            animation: splashTextIn 0.6s ease 1s forwards;
            transition: color 0.2s ease;
            z-index: 1;
        }

        .splash-skip:hover {
            color: var(--primary);
        }

        /* ========================================
           HEADER / NAVIGATION - GRADIENT ACCENTS
        ======================================== */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 70px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid var(--border-primary);
            z-index: 1000;
            transition: all 0.3s ease;
        }

        [data-theme="dark"] .header {
            background: rgba(17, 24, 39, 0.9);
        }

        .header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--gradient-start), var(--gradient-mid), var(--gradient-end));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .header.scrolled::after {
            opacity: 1;
        }

        .header.scrolled {
            box-shadow: var(--shadow-md);
        }

        .header .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--space-5);
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

        .nav-brand img {
            height: 42px;
            width: auto;
            transition: transform 0.3s var(--ease-spring);
        }

        .nav-brand:hover img {
            transform: scale(1.05);
        }

        .nav-brand-text {
            display: flex;
            flex-direction: column;
        }

        .nav-brand-name {
            font-size: var(--text-base);
            font-weight: 600;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.2;
        }

        .nav-brand-tagline {
            font-size: var(--text-xs);
            color: var(--text-tertiary);
            font-style: italic;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: var(--space-1);
        }

        .nav-link {
            padding: var(--space-2) var(--space-4);
            font-size: var(--text-sm);
            font-weight: 500;
            color: var(--text-secondary);
            border-radius: var(--radius-full);
            transition: all 0.2s ease;
            position: relative;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 4px;
            left: 50%;
            transform: translateX(-50%) scaleX(0);
            width: 20px;
            height: 2px;
            background: linear-gradient(90deg, var(--gradient-start), var(--gradient-end));
            border-radius: 1px;
            transition: transform 0.3s var(--ease-spring);
        }

        .nav-link:hover {
            color: var(--primary);
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            transform: translateX(-50%) scaleX(1);
        }

        .nav-link.active {
            color: var(--primary);
            background: rgba(0, 172, 193, 0.08);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

        .theme-toggle {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--text-secondary);
            background: var(--bg-secondary);
            border-radius: 50%;
            transition: all 0.2s ease;
        }

        .theme-toggle:hover {
            color: var(--primary);
            background: var(--bg-tertiary);
            box-shadow: 0 0 20px rgba(0, 172, 193, 0.2);
        }
        
        .theme-toggle svg {
            width: 20px;
            height: 20px;
        }

        .nav-toggle {
            display: none;
            width: 42px;
            height: 42px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .nav-toggle span {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--text-primary);
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .nav-toggle.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
            background: var(--primary);
        }

        .nav-toggle.active span:nth-child(2) {
            opacity: 0;
        }

        .nav-toggle.active span:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
            background: var(--accent);
        }

        @media (max-width: 968px) {
            .nav-menu {
                position: fixed;
                top: 70px;
                left: 0;
                right: 0;
                bottom: 0;
                background: var(--bg-primary);
                flex-direction: column;
                align-items: stretch;
                padding: var(--space-5);
                gap: 0;
                transform: translateX(100%);
                transition: transform 0.3s ease;
            }

            .nav-menu.active {
                transform: translateX(0);
            }

            .nav-link {
                padding: var(--space-4);
                font-size: var(--text-lg);
                border-bottom: 1px solid var(--border-primary);
                border-radius: 0;
            }

            .nav-link::after {
                display: none;
            }

            .nav-toggle {
                display: flex;
            }
        }

        /* ========================================
           MAIN CONTENT
        ======================================== */
        .main-content {
            padding-top: 70px;
            min-height: 100vh;
        }

        /* ========================================
           PAGE HERO SECTION - GRADIENT THEME
        ======================================== */
        .page-hero {
            position: relative;
            padding: var(--space-20) var(--space-5);
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('../images/tbpix/Team.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            text-align: center;
            overflow: hidden;
            min-height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .page-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(0, 172, 193, 0.08) 0%, transparent 50%),
                        radial-gradient(circle at 80% 50%, rgba(156, 39, 176, 0.08) 0%, transparent 50%);
            animation: heroGlow 15s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes heroGlow {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(5%, 5%); }
        }

        .page-hero-content {
            position: relative;
            max-width: 700px;
            margin: 0 auto;
            z-index: 10;
        }

        .page-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            padding: var(--space-2) var(--space-4);
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.1));
            color: var(--white);
            font-size: var(--text-sm);
            font-weight: 600;
            border-radius: var(--radius-full);
            margin-bottom: var(--space-5);
            border: 1px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(10px);
        }

        .page-hero-badge i {
            font-size: 18px;
        }

        .page-hero-title {
            font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
            font-weight: 700;
            color: var(--white);
            line-height: 1.1;
            letter-spacing: -0.02em;
            margin-bottom: var(--space-4);
        }

        .page-hero-title span {
            background: linear-gradient(135deg, #00D4FF, #7C4DFF, #FF80EB);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-hero-description {
            font-size: var(--text-lg);
            color: rgba(255, 255, 255, 0.9);
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.7;
        }

        /* ========================================
           CONTROLS SECTION - iOS STYLE
        ======================================== */
        .controls-section {
            position: sticky;
            top: 70px;
            z-index: 100;
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border-primary);
            padding: var(--space-4) var(--space-5);
        }

        [data-theme="dark"] .controls-section {
            background: var(--bg-primary);
        }

        .controls-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-4);
            flex-wrap: wrap;
        }

        .search-wrapper {
            flex: 1;
            max-width: 400px;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: var(--space-3) var(--space-4) var(--space-3) var(--space-12);
            font-size: var(--text-base);
            font-family: inherit;
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: var(--radius-xl);
            color: var(--text-primary);
            transition: all 0.2s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--bg-primary);
            box-shadow: 0 0 0 4px rgba(0, 172, 193, 0.1);
        }

        .search-input::placeholder {
            color: var(--text-tertiary);
        }

        .search-icon {
            position: absolute;
            left: var(--space-4);
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
            color: var(--text-tertiary);
            pointer-events: none;
        }

        .controls-right {
            display: flex;
            align-items: center;
            gap: var(--space-4);
        }

        .result-count {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
        }

        .result-count strong {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 600;
        }

        .view-toggle {
            display: flex;
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: var(--radius-lg);
            padding: 4px;
            gap: 4px;
        }

        .view-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-2);
            padding: var(--space-2) var(--space-4);
            font-size: var(--text-sm);
            font-weight: 500;
            color: var(--text-tertiary);
            border-radius: var(--radius-md);
            transition: all 0.2s ease;
        }

        .view-btn i {
            font-size: 18px;
        }

        .view-btn:hover:not(.active) {
            color: var(--text-primary);
            background: var(--bg-tertiary);
        }

        .view-btn.active {
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid));
            color: var(--white);
            box-shadow: var(--shadow-sm);
        }

        @media (max-width: 768px) {
            .controls-container {
                flex-direction: column;
                align-items: stretch;
            }

            .search-wrapper {
                max-width: 100%;
            }

            .controls-right {
                justify-content: space-between;
            }
        }

        /* ========================================
           TEAM SECTION
        ======================================== */
        .team-section {
            padding: var(--space-12) var(--space-5) var(--space-20);
            background: var(--bg-secondary);
            min-height: 60vh;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--space-6);
            max-width: 1200px;
            margin: 0 auto;
        }

        /* List View */
        .team-grid.list-view {
            grid-template-columns: 1fr;
            max-width: 800px;
            gap: var(--space-4);
        }

        @media (max-width: 1200px) {
            .team-grid { grid-template-columns: repeat(3, 1fr); }
        }

        @media (max-width: 968px) {
            .team-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 640px) {
            .team-grid { grid-template-columns: 1fr; }
        }

        /* ========================================
           TEAM CARD - iOS STYLE GRID VIEW
        ======================================== */
        .team-card {
            background: var(--bg-primary);
            border-radius: var(--radius-2xl);
            overflow: hidden;
            border: 1px solid var(--border-primary);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s var(--ease-spring);
            opacity: 0;
            transform: translateY(20px);
        }

        .team-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .team-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl), 0 0 40px rgba(0, 172, 193, 0.1);
            border-color: var(--primary-light);
        }

        .card-image-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 1;
            background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-secondary) 100%);
            overflow: hidden;
        }

        .card-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            transform: scale(1.0);
        }

        .card-placeholder {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--gradient-start) 0%, var(--gradient-mid) 100%);
            color: var(--white);
            font-size: 56px;
            font-weight: 700;
            letter-spacing: -2px;
        }

        /* Role Icon - Bottom Left of Image */
        .card-role-icon {
            position: absolute;
            bottom: var(--space-3);
            left: var(--space-3);
            width: 44px;
            height: 44px;
            background: var(--bg-primary);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--primary);
            box-shadow: var(--shadow-lg);
            border: 2px solid var(--bg-primary);
            z-index: 2;
        }

        /* Badge - Top Right */
        .card-badge {
            position: absolute;
            top: var(--space-3);
            right: var(--space-3);
            display: flex;
            align-items: center;
            gap: var(--space-1);
            padding: var(--space-1) var(--space-3);
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: var(--radius-full);
            font-size: var(--text-xs);
            font-weight: 600;
            color: var(--primary);
            box-shadow: var(--shadow-md);
            z-index: 2;
        }

        .card-badge i {
            font-size: 12px;
            color: var(--accent);
        }

        .card-body {
            padding: var(--space-5);
        }

        .card-name {
            font-size: var(--text-base);
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: var(--space-1);
            line-height: 1.3;
        }

        .card-role {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
            margin-bottom: var(--space-4);
        }

.card-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid));
    color: var(--white);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
    cursor: pointer;
}

.card-btn:hover {
    background: linear-gradient(135deg, var(--gradient-mid), var(--gradient-end));
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 172, 193, 0.3);
}

.card-btn i {
    font-size: 16px;
    transition: transform 0.2s ease;
}

.card-btn:hover i {
    transform: translateX(3px);
}

/* Skeleton Loading */
.skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: skeletonLoading 1.5s infinite;
    border-radius: var(--radius-lg);
}

@keyframes skeletonLoading {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

.team-card.skeleton {
    height: 300px;
}

.card-image-wrapper.skeleton {
    height: 100%;
    width: 100%;
}

.card-body.skeleton {
    height: 100px;
    padding: var(--space-4);
}

        .card-btn:hover {
            background: linear-gradient(135deg, var(--gradient-mid), var(--gradient-end));
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 172, 193, 0.3);
        }

        .card-btn i {
            font-size: 16px;
            transition: transform 0.2s ease;
        }

        .card-btn:hover i {
            transform: translateX(3px);
        }

        /* ========================================
           TEAM CARD - LIST VIEW
        ======================================== */
        .team-grid.list-view .team-card {
            display: flex;
            flex-direction: row;
            align-items: center;
        }

        .team-grid.list-view .team-card:hover {
            transform: translateX(8px);
        }

        .team-grid.list-view .card-image-wrapper {
            width: 80px;
            min-width: 80px;
            height: 80px;
            aspect-ratio: 1;
            border-radius: var(--radius-xl);
            margin: var(--space-4);
        }

        .team-grid.list-view .card-image-wrapper img {
            border-radius: var(--radius-xl);
        }

        .team-grid.list-view .card-placeholder {
            font-size: 28px;
            border-radius: var(--radius-xl);
        }

        .team-grid.list-view .card-role-icon {
            width: 28px;
            height: 28px;
            font-size: 14px;
            bottom: var(--space-1);
            left: var(--space-1);
            border-radius: var(--radius-md);
        }

        .team-grid.list-view .card-badge {
            display: none;
        }

        .team-grid.list-view .card-body {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: var(--space-4);
            padding-left: 0;
            gap: var(--space-4);
        }

        .team-grid.list-view .card-info {
            flex: 1;
        }

        .team-grid.list-view .card-name {
            font-size: var(--text-base);
            margin-bottom: var(--space-1);
        }

        .team-grid.list-view .card-role {
            margin-bottom: 0;
        }

        .team-grid.list-view .card-btn {
            width: auto;
            padding: var(--space-2) var(--space-4);
        }

        /* ========================================
           NO RESULTS
        ======================================== */
        .no-results {
            display: none;
            text-align: center;
            padding: var(--space-20) var(--space-5);
            max-width: 400px;
            margin: 0 auto;
        }

        .no-results.visible {
            display: block;
        }

        .no-results-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, rgba(0, 172, 193, 0.1), rgba(156, 39, 176, 0.1));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto var(--space-6);
            font-size: 32px;
            color: var(--primary);
        }

        .no-results-title {
            font-size: var(--text-xl);
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: var(--space-2);
        }

        .no-results-text {
            font-size: var(--text-base);
            color: var(--text-tertiary);
            margin-bottom: var(--space-6);
        }

        .no-results-btn {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            padding: var(--space-3) var(--space-6);
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid));
            color: var(--white);
            font-size: var(--text-sm);
            font-weight: 600;
            border-radius: var(--radius-full);
            transition: all 0.2s ease;
        }

        .no-results-btn:hover {
            background: linear-gradient(135deg, var(--gradient-mid), var(--gradient-end));
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 172, 193, 0.3);
        }

        /* ========================================
           FOOTER
        ======================================== */
        .footer {
            background: var(--bg-tertiary);
            padding: var(--space-16) var(--space-5) var(--space-8);
        }

        [data-theme="dark"] .footer {
            background: #0a0a0a;
        }

        .footer .container {
            max-width: 1200px;
            margin: 0 auto;
        }

    /* ========================================
       FOOTER
       ======================================== */
    .footer {
      background: var(--bg-tertiary);
      padding: 18px 0 10px;
    }

    [data-theme="dark"] .footer {
      background: #050508;
    }



        /* ========================================
           BACK TO TOP
        ======================================== */
        .back-to-top {
            position: fixed;
            bottom: var(--space-6);
            right: var(--space-6);
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid));
            color: var(--white);
            border-radius: 50%;
            font-size: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: all 0.3s var(--ease-spring);
            z-index: 998;
            box-shadow: var(--shadow-lg);
        }

        .back-to-top.visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .back-to-top:hover {
            background: linear-gradient(135deg, var(--gradient-mid), var(--gradient-end));
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 172, 193, 0.4);
        }

        /* ========================================
           ANIMATIONS
        ======================================== */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s var(--ease-out);
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Reduced Motion */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
            .splash { display: none !important; }
        }

        /* ========================================
           SECTION TAGS
           ======================================== */
        .section-tags {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 500;
            border-radius: 9999px;
            text-decoration: none;
            transition: all 0.25s ease;
        }

        .tag i {
            font-size: 14px;
        }

        .tag--primary {
            background: var(--gradient-primary);
            color: var(--white);
        }

        .tag--primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .tag--accent {
            background: var(--gradient-accent);
            color: var(--white);
        }

        .tag--accent:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .tag--outline {
            background: var(--bg-primary);
            color: var(--text-secondary);
            border: 1px solid var(--border-primary);
        }

        .tag--outline:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-50);
        }

        .tag--sm {
            padding: 6px 12px;
            font-size: 12px;
        }

        .tag--sm i {
            font-size: 12px;
        }
    </style>
</head>
